        <hashTree><JSONPostProcessor guiclass="JSONPostProcessorGui" testclass="JSONPostProcessor" testname="Extract cbState" enabled="true">
            <stringProp name="JSONPostProcessor.referenceNames">cbState</stringProp>
            <stringProp name="JSONPostProcessor.jsonPathExprs">$.circuitBreakers.kitchen.state</stringProp>
